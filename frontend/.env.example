# ── API Base URL ──────────────────────────────────────────────────────────────
# Leave empty when using Vite proxy (development)
# Set to your deployed backend URL in production
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=
