# Backend Environment Variables — Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — only commit .env.example

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Option A: SRV format (recommended if your DNS resolves SRV records)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Option B: Direct connection (use if DNS/SRV fails — replace shard hosts accordingly)
# MONGO_URI=mongodb://<username>:<password>@host1:27017,host2:27017,host3:27017/<dbname>?ssl=true&replicaSet=<rs-name>&authSource=admin&appName=<app>

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/society-management?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a strong random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── WhatsApp Business API (optional bonus feature) ────────────────────────────
# Set WHATSAPP_MODE=mock to run the mock implementation (no real API calls)
# Set WHATSAPP_MODE=live to use the real WhatsApp Business API
WHATSAPP_MODE=mock
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
